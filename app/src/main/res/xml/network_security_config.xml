<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The public edition requires HTTPS. Personal overrides this resource for LAN HTTP. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
