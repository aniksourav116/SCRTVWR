<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower; data_extraction_rules.xml covers Android 12 and up.
   See https://developer.android.com/guide/topics/data/autobackup

   HTTP server passwords stay on the device. After a restore the servers come back without them,
   and their cards ask to sign in again.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="scrtvwr_http_credentials.xml" />
</full-backup-content>
